# Copy to .env.local and fill in. Never commit real keys.

# Supabase Postgres connection string (server-only, never exposed to the browser).
# Supabase → your project → "Connect" → Transaction pooler (port 6543).
# Replace [YOUR-PASSWORD] with the database password (Project Settings → Database).
# The publishable/anon keys are not needed: tickets are written by the server only.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Paystack: Dashboard → Settings → API Keys & Webhooks (use sk_test_… while testing)
PAYSTACK_SECRET_KEY=sk_test_xxx

# Resend: https://resend.com/api-keys. Without it, emails are saved to .dev-emails/
RESEND_API_KEY=re_xxx
EMAIL_FROM="DevFest Jos <tickets@yourdomain.com>"

# Public site URL used in emails and Paystack callbacks
NEXT_PUBLIC_SITE_URL=https://devfestjos.com92d16805

# Admin dashboard (all three required; otherwise the admin area returns 404)
# Secret URL segment → https://yoursite/<ADMIN_PATH>. Make it unguessable.
ADMIN_PATH=ops-change-me-7Kq9x2
# Whitelisted emails with their own 6–12 digit PIN, comma separated
ADMIN_USERS=you@example.com:482913,teammate@example.com:771204
# Long random string for signing sessions (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# Agent Mode + Level Up (/quest)
# Signs attendee sessions and the rotating entrance codes (openssl rand -hex 32).
QUEST_SESSION_SECRET=
# Google sign-in runs through Supabase Auth (Project Settings → API).
# In Supabase: Authentication → Providers → Google on, and add
# <NEXT_PUBLIC_SITE_URL>/quest/auth/callback under Authentication → URL Configuration → Redirect URLs.
# Without these, local dev shows an email-only sign-in page instead.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# sb_publishable_… (a legacy anon key also works, as NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hall screen lives at /quest/hall?key=<this>. Make it unguessable: it shows the check-in QR.
QUEST_HALL_KEY=
# X API (developer.x.com, pay-per-use) app-only bearer token: verifies posts for the +5 mission.
X_BEARER_TOKEN=
# Protects /api/quest/cron (X search every 15 min, deleted-post recheck daily). See db/quest-cron.sql.
CRON_SECRET=
# Optional: force a phase (pre | event | post) to test venue features or run the 16 Oct dry run. Remove after.
QUEST_PHASE=
