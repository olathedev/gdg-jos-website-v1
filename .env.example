# Copy to .env.local and fill in. Never commit real keys.

# Supabase Postgres connection string (server-only, never exposed to the browser).
# Supabase → your project → "Connect" → Transaction pooler (port 6543).
# Replace [YOUR-PASSWORD] with the database password (Project Settings → Database).
# The publishable/anon keys are not needed: tickets are written by the server only.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Paystack: Dashboard → Settings → API Keys & Webhooks (use sk_test_… while testing)
PAYSTACK_SECRET_KEY=sk_test_xxx

# Resend: https://resend.com/api-keys. Without it, emails are saved to .dev-emails/
RESEND_API_KEY=re_xxx
EMAIL_FROM="DevFest Jos <tickets@yourdomain.com>"

# Public site URL used in emails and Paystack callbacks
NEXT_PUBLIC_SITE_URL=https://devfestjos.com
